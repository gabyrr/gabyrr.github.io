@inproceedings{villatoro2021approx,
author = {Villatoro-Tello, Esaú and Ramírez-de-la-Rosa, Gabriela and Gática-Pérez, Daniel and Magimai.-Doss, Mathew and Jiménez-Salazar, Héctor},
title = {Approximating the Mental Lexicon from Clinical Interviews as a Support Tool for Depression Detection},
year = {2021},
isbn = {9781450384810},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://dl.acm.org/doi/10.1145/3462244.3479896},
doi = {10.1145/3462244.3479896},
abstract = {Depression disorder is one of the major causes of disability in the world that can lead to tragic outcomes. In this paper, we propose a method for using an approximation to a mental lexicon to model the communication process of depressed and non-depressed participants in spontaneous North American English clinical interviews. Our approach, inspired by the Lexical Availability theory, identifies the most relevant vocabulary of the interviewed participant, and use it as features in a classification process. We performed an in-depth evaluation on the DAIC-WOZ [20] and the E-DAIC [11] clinical datasets. Obtained results indicate that our approach can compete against recent contextual embeddings when modeling and identifying depression. We show the generalization capabilities of our algorithm using outside data, reaching a macro F1 = 0.83 and F1 = 0.80 in the DAIC-WOZ and E-DAIC datasets respectively. An analysis of our method’s interpretability allows understanding how the classifier is making its decisions. During this process, we observed strong connections between our obtained results and previous research from the psychological field.},
booktitle = {Proceedings of the 2021 International Conference on Multimodal Interaction},
pages = {557–566},
numpages = {10},
keywords = {Text Classification, Mental Lexicon, Language Production, Interpretable Models, Depression Detection},
location = {Montréal, QC, Canada},
series = {ICMI '21}
}

